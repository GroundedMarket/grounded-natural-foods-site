rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- role helpers (claims are set server-side by Cloud Functions;
    //      they cannot be faked from a browser) ----
    function signedIn(){ return request.auth != null; }
    function isMaster(){ return signedIn() && request.auth.token.role == 'master'; }
    function isStaff(){
      return signedIn() && (request.auth.token.role == 'master'
        || request.auth.token.role == 'employee'
        || request.auth.token.role == 'display');
    }

    // ---- PUBLIC MENU DATA: anyone on the site (incl. silent anonymous
    //      customers) can read; only master can change ----
    match /deliBoxes/{id}        { allow read: if signedIn(); allow write: if isMaster(); }
    match /deliItems/{id}        { allow read: if signedIn(); allow write: if isMaster(); }
    match /deliWeeklyMenus/{id}  { allow read: if signedIn(); allow write: if isMaster(); }
    match /soups/{id}            { allow read: if signedIn(); allow write: if isMaster(); }
    match /soupSizes/{id}        { allow read: if signedIn(); allow write: if isMaster(); }
    match /soupMenuDays/{id}     { allow read: if signedIn(); allow write: if isMaster(); }
    match /customBarBoxes/{id}   { allow read: if signedIn(); allow write: if isMaster(); }
    match /customBarItems/{id}   { allow read: if signedIn(); allow write: if isMaster(); }
    match /coffeeItems/{id}      { allow read: if signedIn(); allow write: if isMaster(); }
    match /coffeeAddons/{id}     { allow read: if signedIn(); allow write: if isMaster(); }
    match /coffeeMilks/{id}      { allow read: if signedIn(); allow write: if isMaster(); }
    match /coffeeFlavorCategories/{id} { allow read: if signedIn(); allow write: if isMaster(); }
    match /coffeeFlavors/{id}    { allow read: if signedIn(); allow write: if isMaster(); }
    match /produce/{id}          { allow read: if signedIn(); allow write: if isMaster(); }
    match /closedDates/{id}      { allow read: if signedIn(); allow write: if isMaster(); }
    match /store/settings        { allow read: if signedIn(); allow write: if isMaster(); }

    // ---- MEATS & CHEESE ----
    // meatCheeseItems is the catalog (name, brand, price, notes, emoji,
    // availableWeight). Customers read it (for the public ordering list),
    // only master may create/rename/retire an item — EXCEPT the
    // availableWeight rollup, which any staff member updates as they add,
    // weigh, move, or fulfill blocks in the deli case (see app.js:
    // recalcMeatCheeseAvailableWeight). This is the ONLY inventory number
    // customers' reads ever see — individual pieces/dates live only in
    // meatCheeseBlocks, which customers can never read at all.
    match /meatCheeseItems/{id}  {
      allow read: if signedIn();
      allow write: if isMaster();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableWeight']);
    }
    // meatCheeseSlots is just which catalog item sits in which visual case
    // position — not sensitive, but staff (not just master) assign/drag
    // these, same as everyone being able to arrange the physical case.
    match /meatCheeseSlots/{id}  { allow read: if signedIn(); allow write: if isStaff(); }
    // meatCheeseBlocks holds the actual physical pieces — weight and
    // sell-by date — which customers must NEVER see (no expiry dates, no
    // piece counts), so this collection is staff-only at the rules level,
    // not just hidden in the UI.
    match /meatCheeseBlocks/{id} { allow read, write: if isStaff(); }

    // ---- ORDERS: the one narrow public door. Any signed-in visitor
    //      (anonymous customers included) may CREATE an order.
    //      Read is split into two different things on purpose:
    //        - get (fetching ONE specific order by its exact document ID)
    //          is open to any signed-in visitor. This is what lets a
    //          customer's own browser refresh the live status of an order
    //          it already placed (the ID was handed back at checkout and
    //          saved on their device) — but it's useless for anyone who
    //          doesn't already have that exact ID, since IDs aren't
    //          sequential or guessable in practice.
    //        - list (querying/enumerating the whole collection) stays
    //          staff-only, exactly as before, so nobody can just browse or
    //          search every order ever placed.
    //      This intentionally avoids scoping by phone number or any other
    //      guessable value — the document ID itself is the only thing that
    //      grants access, and only staff can ever discover IDs in bulk.
    //      Update/delete remain staff-only. ----
    match /orders/{id}{
      allow create: if signedIn();
      allow get: if isStaff() || signedIn();
      allow list: if isStaff();
      allow update, delete: if isStaff();
    }

    // ---- STAFF OPERATIONAL DATA: staff read/write ----
    match /expirationItems/{id}  { allow read, write: if isStaff(); }
    match /localUpcDb/{id}       { allow read, write: if isStaff(); }
    // "Site Edits" checklist (under Chat). Staff-wide at the rules level,
    // same bar as the rest of this block — the app's UI only ever shows
    // this tab to master and one specific employee, but it isn't a hard
    // per-person security boundary enforced by these rules.
    match /siteEdits/{id}        { allow read, write: if isStaff(); }
    match /chatMessages/{id}     {
      allow read, create: if isStaff();
      allow update, delete: if isMaster();
      // Narrow carve-out so any staff member can RSVP to an event, vote on
      // a poll, or like/unlike a message (touching only those fields)
      // without being able to edit or delete anyone's actual message
      // content — that stays master-only, same as before.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps', 'pollVotes', 'likes']);
    }
    match /scheduleShifts/{id}   {
      allow read: if isStaff();
      allow read, write: if isMaster();
    }
    match /timeOffRequests/{id} {
      allow read: if isStaff();
      // isMaster() is a separate OR branch (not just the employeeId-match
      // branch) so master can log a request on ANY employee's behalf — the
      // match-your-own-id branch alone only covers an employee filing their
      // own request, since master's own auth token has no employeeId to
      // match against someone else's.
      allow create: if isStaff()
        && (isMaster() || request.resource.data.employeeId == request.auth.token.employeeId);
      allow update: if isMaster();
    }
    match /shiftSwaps/{id}       {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.employeeId == request.auth.token.employeeId;
      allow update: if isMaster();
    }
    match /publishedWeeks/{id}   { allow read: if isStaff(); allow write: if isMaster(); }
    match /recipeBinders/{id}    { allow read: if isStaff(); allow write: if isMaster(); }
    match /recipes/{id}          { allow read: if isStaff(); allow write: if isMaster(); }
    match /categories/{id}       { allow read, write: if isStaff(); }
    match /roles/{id}            { allow read: if isStaff(); allow write: if isMaster(); }

    // ---- EMPLOYEES: profiles readable by staff; only master (or the
    //      Cloud Functions, which bypass rules entirely) may write.
    //      Passwords no longer live here at all after migration. ----
    match /employees/{id}        {
      allow read: if isStaff();
      allow write: if isMaster();
      // Narrow carve-out so an employee can save their own personal
      // display preferences (schedule tab section order, chat emoji icon)
      // to their own record — touching only those two fields, and only on
      // their OWN document (id must match their token's employeeId).
      // Everything else about employee records — pay, roles, schedule,
      // login, etc — stays master-only exactly as before.
      allow update: if isStaff() && request.auth.token.employeeId == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scheduleSectionOrder', 'chatIcon']);
    }

    // ---- THANKSGIVING TURKEYS ----
    // Inventory is the public availability list: weight, type, and status
    // only. It must never carry a customer name or phone.
    // Reservations hold the name and phone. Visitors may create one for a
    // weight that is still available, and may not read any reservation.
    // Master, and employees whose role contains "management", run the
    // Turkeys tab: list reservations, un-reserve, mark picked up, and
    // add/edit/remove weights. No email or text is sent from here.
    function isManagement() {
      return signedIn()
        && request.auth.token.role == 'employee'
        && request.auth.token.employeeId is string
        && exists(/databases/$(database)/documents/employees/$(request.auth.token.employeeId))
        && get(/databases/$(database)/documents/employees/$(request.auth.token.employeeId)).data.role.matches('(?i).*management.*');
    }
    function canManageTurkeys() {
      return isMaster() || isManagement();
    }
    function turkeyWeightOk(weight) {
      return weight is string && weight.matches('^\\d{1,2}(\\.\\d{1,2})?$');
    }
    function turkeyTypeOk(type) {
      return type == 'organic' || type == 'freeRange';
    }

    match /turkeyInventory/{id} {
      allow get, list: if signedIn();
      allow create: if canManageTurkeys()
        && turkeyTypeOk(request.resource.data.type)
        && turkeyWeightOk(request.resource.data.weight)
        && request.resource.data.status in ['available', 'reserved', 'pickedUp']
        && request.resource.data.keys().hasOnly([
          'type', 'weight', 'status', 'sort', 'reservationId', 'reservedAt'
        ])
        && !request.resource.data.keys().hasAny(['name', 'phone']);
      allow update: if canManageTurkeys()
        && turkeyTypeOk(request.resource.data.type)
        && turkeyWeightOk(request.resource.data.weight)
        && request.resource.data.status in ['available', 'reserved', 'pickedUp']
        && !request.resource.data.keys().hasAny(['name', 'phone']);
      // A shopper can only claim a weight that is still available, and only
      // by stamping status / reservationId / reservedAt. They cannot put it
      // back or attach a name.
      allow update: if signedIn()
        && resource.data.status == 'available'
        && request.resource.data.status == 'reserved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reservationId', 'reservedAt'
        ])
        && request.resource.data.reservationId is string
        && request.resource.data.reservationId.size() > 0
        && request.resource.data.reservedAt == request.time
        && !request.resource.data.keys().hasAny(['name', 'phone']);
      allow delete: if canManageTurkeys();
    }

    match /turkeyReservations/{id} {
      allow get, list: if canManageTurkeys();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'inventoryId', 'type', 'weight', 'name', 'phone', 'pickupDate', 'createdAt', 'status'
        ])
        && request.resource.data.keys().hasAll([
          'inventoryId', 'type', 'weight', 'name', 'phone', 'createdAt', 'status'
        ])
        && request.resource.data.status == 'reserved'
        && request.resource.data.inventoryId is string
        && turkeyTypeOk(request.resource.data.type)
        && turkeyWeightOk(request.resource.data.weight)
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 40
        && request.resource.data.createdAt == request.time
        && (
          !request.resource.data.keys().hasAny(['pickupDate'])
          || request.resource.data.pickupDate == null
          || (
            request.resource.data.pickupDate is string
            && request.resource.data.pickupDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
            && request.resource.data.pickupDate <= '2026-12-31'
          )
        )
        && exists(/databases/$(database)/documents/turkeyInventory/$(request.resource.data.inventoryId))
        && get(/databases/$(database)/documents/turkeyInventory/$(request.resource.data.inventoryId)).data.status == 'available'
        && get(/databases/$(database)/documents/turkeyInventory/$(request.resource.data.inventoryId)).data.type == request.resource.data.type
        && get(/databases/$(database)/documents/turkeyInventory/$(request.resource.data.inventoryId)).data.weight == request.resource.data.weight;
      // Staff seed for weights that were already spoken for before launch.
      allow create: if canManageTurkeys()
        && request.resource.data.keys().hasOnly([
          'inventoryId', 'type', 'weight', 'name', 'phone', 'pickupDate', 'createdAt', 'status', 'seeded'
        ])
        && request.resource.data.status in ['reserved', 'pickedUp']
        && request.resource.data.seeded == true
        && turkeyTypeOk(request.resource.data.type)
        && turkeyWeightOk(request.resource.data.weight)
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && !request.resource.data.keys().hasAny(['email']);
      allow update: if canManageTurkeys()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'type', 'weight'
        ])
        && request.resource.data.status in ['reserved', 'pickedUp', 'cancelled']
        && turkeyTypeOk(request.resource.data.type)
        && turkeyWeightOk(request.resource.data.weight);
      allow delete: if canManageTurkeys();
    }

    // Anything not listed: denied.
    match /{document=**}         { allow read, write: if false; }
  }
}
